PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/smart-print?retryWrites=true&w=majority
JWT_SECRET=any_long_random_string_here_for_local_testing
JWT_EXPIRE=7d
FRONTEND_URL=http://localhost:5173
MAX_FILE_SIZE_MB=20

# Firebase Storage Configuration (Optional: defaults to local disk if blank/unconfigured for local dev)
FIREBASE_SERVICE_ACCOUNT_PATH=src/config/serviceAccountKey.json
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Default Pricing Configuration
PRICE_BW_PER_PAGE=3
PRICE_COLOR_PER_PAGE=5
